#!/usr/bin/env bash
# seance: a Claude Code session per Jira ticket (or any piece of work), each in its own git worktree.
#
# Start and come back
#   seance <repo> <TICKET>                   start the ticket's session, or resume its last one
#   seance <repo>,<repo2> <TICKET>           one session across several repos, a worktree in each
#   seance <repo> <TICKET> "<prompt>"        your own first prompt instead of "get oriented and wait"
#   seance -n <repo> <name>                  the same for work with no ticket: any name, no Jira
#
# Fork a session onto another ticket (it keeps the whole conversation)
#   seance <repo> <TICKET> <session-id>      fork that session
#   seance <repo> <TICKET> here              fork the session this runs inside (a few seconds on,
#                                            once this command has finished)
#
# Inside a running session
#   seance add <repo>[,<repo2>] [<TICKET>]   add repos' worktrees for the session's ticket
#   seance title "<words>"                   name this session <repo>-<ticket>-<words>
#
# Find and open sessions
#   seance list                              repos, worktrees, branches and sessions
#   seance list --json                       the same as JSON, for other tools
#   seance pick                              choose one from a menu; attach to it or resume it
#   seance open <session-id>                 attach to or resume that one, as pick would
#   seance title <session-id> "<words>"      name any seance session
#   seance repos                             the lookup table
#
# Options, before the arguments
#   --title "<words>"    start the session already named <repo>-<ticket>-<words>
#   --base <branch>      start new branches from origin/<branch> instead of the default
#   -n, --no-jira        the second argument is a plain name, not a Jira key
#   --new                start a fresh session even if the ticket has one
#   --bg                 start in the background (always so when Claude runs seance)
#   --no-fetch           branch from origin/<base> as last fetched
#   -h, --help           this help
#
# Settings, in ~/.seance/config as NAME=value lines or as environment variables (which win)
#   SEANCE_BRANCH_FORMAT   branch name template, default feature/{ticket} ({repo} also works)
#   SEANCE_JIRA_URL        your Jira site (https://example.atlassian.net), for ticket links
#   SEANCE_NOTES_DIR       notes on your repos (INDEX.md, <repo>.md) for sessions to read
#   SEANCE_HOME            where config, the repo table and records live, default ~/.seance
#                          (environment only)
#
# More: README.md in the seance repo, and app/README.md there for the desktop app.

set -euo pipefail

SEANCE_HOME="${SEANCE_HOME:-$HOME/.seance}"
CONFIG_FILE="$SEANCE_HOME/config"
REPOS_FILE="$SEANCE_HOME/repos"
SESSIONS_FILE="$SEANCE_HOME/sessions.tsv"
TITLES_FILE="$SEANCE_HOME/titles.tsv"
WORKTREE_DIR=".claude/worktrees"
BASE_OVERRIDE=""
TITLE_SLUG=""
FORK_DELAY=${SEANCE_FORK_DELAY:-6}
START_NAME=""

# A setting from the environment, else from the config file. The file is read as NAME=value
# lines, never run; surrounding quotes are dropped and a leading ~/ means the home folder.
setting() {
  local name=$1 value=${!1:-}
  if [[ -z "$value" && -f "$CONFIG_FILE" ]]; then
    value=$(awk -v name="$name" '
      /^[[:space:]]*(#|$)/ { next }
      { line = $0; sub(/^[[:space:]]*(export[[:space:]]+)?/, "", line) }
      index(line, name "=") == 1 { value = substr(line, length(name) + 2) }
      END { print value }' "$CONFIG_FILE")
    value=${value%"${value##*[![:space:]]}"}
    if [[ "$value" =~ ^\"(.*)\"$ || "$value" =~ ^\'(.*)\'$ ]]; then value=${BASH_REMATCH[1]}; fi
    [[ "$value" != "~/"* ]] || value="$HOME/${value#\~/}"
  fi
  printf '%s' "$value"
}

BRANCH_FORMAT=$(setting SEANCE_BRANCH_FORMAT)
[[ -n "$BRANCH_FORMAT" ]] || BRANCH_FORMAT='feature/{ticket}'
JIRA_URL=$(setting SEANCE_JIRA_URL)
JIRA_URL="${JIRA_URL%/}"
NOTES_DIR=$(setting SEANCE_NOTES_DIR)
NOTES_DIR="${NOTES_DIR%/}"

ticket_url() {
  [[ -n "$JIRA_URL" ]] && echo "$JIRA_URL/browse/$1"
}

# How the session should find the ticket: by its link and site when SEANCE_JIRA_URL is set.
ticket_source() {
  local ticket=$1
  if [[ -n "$JIRA_URL" ]]; then
    local host=${JIRA_URL#*://}
    echo "$ticket ($(ticket_url "$ticket")) with the Atlassian MCP, using $host as the cloudId"
  else
    echo "$ticket with the Atlassian MCP"
  fi
}

die() { echo "seance: $*" >&2; exit 1; }
note() { echo "seance: $*" >&2; }

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

is_terminal() { [[ -t 0 && -t 1 ]]; }

is_jira_key() { [[ "$1" =~ ^[A-Z][A-Z0-9]+-[0-9]+$ ]]; }

# A session to fork: here, a session id, or its first 8 characters as seance list shows them.
is_session_ref() { [[ "$1" == here || "$1" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$ ]]; }

# The name for the worktree and branch: a Jira key (uppercased), or with --no-jira any plain name.
# A plain name given without --no-jira is accepted when the first repo already has its worktree.
work_name() {
  local raw=$1 no_jira=$2 first_repo=$3 path
  if [[ "$no_jira" == yes ]]; then
    [[ "$raw" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "'$raw' is not a usable name (letters, digits, '.', '_' and '-')"
    echo "$raw"
    return
  fi
  if is_jira_key "${raw^^}"; then
    echo "${raw^^}"
    return
  fi
  path=$(repo_field "$first_repo" 2)
  if [[ -n "$path" && -d "$path/$WORKTREE_DIR/$raw" ]]; then
    echo "$raw"
    return
  fi
  die "'$raw' does not look like a Jira key (PROJ-123); for work with no ticket, use: seance --no-jira <repo> $raw"
}

branch_name() {
  local repo_name=$1 ticket=$2 branch
  [[ "$BRANCH_FORMAT" == *"{ticket}"* ]] || die "SEANCE_BRANCH_FORMAT must contain {ticket} (it is '$BRANCH_FORMAT')"
  branch=${BRANCH_FORMAT//\{ticket\}/$ticket}
  branch=${branch//\{repo\}/$repo_name}
  git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "'$branch' is not a valid branch name (from SEANCE_BRANCH_FORMAT)"
  echo "$branch"
}

repo_field() {
  [[ -f "$REPOS_FILE" ]] || die "no lookup table at $REPOS_FILE"
  awk -v name="$1" -v col="$2" '$0 !~ /^[[:space:]]*(#|$)/ && $1 == name { print $col; exit }' "$REPOS_FILE"
}

repo_names() {
  awk '$0 !~ /^[[:space:]]*(#|$)/ { print $1 "\t" $2 }' "$REPOS_FILE"
}

repo_table() {
  awk '$0 !~ /^[[:space:]]*(#|$)/ { print $1 "\t" $2 "\t" ($3 == "" ? "(origin default)" : $3) }' "$REPOS_FILE"
}

default_branch() {
  local repo=$1 pinned=$2 ref
  if [[ -n "$pinned" ]]; then
    echo "$pinned"
    return
  fi
  if ref=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
    echo "${ref#origin/}"
    return
  fi
  for ref in main master; do
    if git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$ref"; then
      echo "$ref"
      return
    fi
  done
  die "cannot tell $repo's default branch (no origin/HEAD, origin/main or origin/master)"
}

ensure_excluded() {
  local repo=$1 exclude
  exclude="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  mkdir -p "$(dirname "$exclude")"
  if ! grep -qxF "/$WORKTREE_DIR/" "$exclude" 2>/dev/null; then
    printf '/%s/\n' "$WORKTREE_DIR" >>"$exclude"
    note "added /$WORKTREE_DIR/ to $exclude (local ignore, not committed)"
  fi
}

worktree_for_branch() {
  git -C "$1" worktree list --porcelain | awk -v want="branch refs/heads/$2" '
    /^worktree / { path = substr($0, 10) }
    $0 == want { print path; exit }'
}

prepare_worktree() {
  local repo=$1 ticket=$2 do_fetch=$3 pinned=$4 branch=$5
  local wt="$repo/$WORKTREE_DIR/$ticket" existing base

  ensure_excluded "$repo"

  existing=$(worktree_for_branch "$repo" "$branch")
  if [[ -n "$existing" ]]; then
    note "reusing worktree $existing ($branch)"
    [[ -z "$BASE_OVERRIDE" ]] || note "--base $BASE_OVERRIDE ignored: the worktree is already there"
    WORKTREE=$existing
    return
  fi
  [[ -e "$wt" ]] && die "$wt exists but is not the worktree for $branch; sort it out by hand"

  if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    note "branch $branch exists; checking it out in a new worktree"
    [[ -z "$BASE_OVERRIDE" ]] || note "--base $BASE_OVERRIDE ignored: the branch is already there"
    git -C "$repo" worktree add "$wt" "$branch" >&2
  else
    base=$(default_branch "$repo" "$pinned")
    if [[ "$do_fetch" == yes ]]; then
      note "fetching origin/$base"
      git -C "$repo" fetch origin "$base" >&2 || die "could not fetch origin/$base in $repo; does that branch exist on the remote?"
    else
      note "not fetching; $branch starts from origin/$base as of the last fetch"
    fi
    git -C "$repo" rev-parse --verify --quiet "refs/remotes/origin/$base" >/dev/null ||
      die "$repo has no origin/$base to branch from"
    git -C "$repo" worktree add --no-track -b "$branch" "$wt" "origin/$base" >&2
  fi
  WORKTREE=$wt
}

record_session() {
  mkdir -p "$SEANCE_HOME"
  [[ -f "$SESSIONS_FILE" ]] || printf 'created\trepo\tticket\tname\tsession_id\tworktree\tforked_from\n' >"$SESSIONS_FILE"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "$@" >>"$SESSIONS_FILE"
}

worktree_lines() {
  local i
  for i in "${!WORKTREES[@]}"; do
    printf -- '- %s: %s (branch %s)\n' "${REPO_NAMES[$i]}" "${WORKTREES[$i]}" "${BRANCHES[$i]}"
  done
}

# The SEANCE_NOTES_DIR files that exist for these repos: INDEX.md, then <repo>.md for each.
notes_files() {
  [[ -n "$NOTES_DIR" ]] || return 0
  local f name
  for f in "$NOTES_DIR/INDEX.md" $(for name in "${REPO_NAMES[@]}"; do echo "$NOTES_DIR/$name.md"; done); do
    [[ -f "$f" ]] && printf -- '- %s\n' "$f"
  done
  return 0
}

# How a session names itself: seance title stores a few words, shown as <repo>-<ticket>-<words>.
# A session started with --title already has its name, so it is only asked to check it.
title_instruction() {
  if [[ -n "$TITLE_SLUG" ]]; then
    echo "check that this session's name, $START_NAME, still fits the work; if it does not, rename it by running: seance title \"<three to five words on what the work is>\". That only records the name and changes nothing in the repos."
  else
    echo 'name this session by running: seance title "<three to five words on what the work is>", for example seance title "rotate demo lb certs". It only records the name (seance shows it as <repo>-<ticket>-<words>) and changes nothing in the repos.'
  fi
}

new_prompt() {
  local ticket=$1 notes orient
  notes=$(notes_files)
  orient="Get up to speed on each repo above: what it is, its README, and how it is laid out."
  if [[ -n "$notes" ]]; then
    orient+=" Start with these notes on the repos and how they connect to each other. They may be out of date, so check the code where it matters:
$notes"
  fi
  if [[ "$JIRA" == no ]]; then
    cat <<EOF
Start work on $ticket. This is not a Jira ticket: there is nothing to look up, and I will describe the work.

These git worktrees were made for it, one per repo. Read and change files only in them, never in the repo folders themselves. Your working directory is the first.
$(worktree_lines)

$orient
Then tell me briefly what you found, and stop. Do not change anything until I say what the work is.
When I have described the work, $(title_instruction)
EOF
    return
  fi
  cat <<EOF
Start work on Jira ticket $ticket.

These git worktrees were made for this ticket, one per repo. Read and change files only in them, never in the repo folders themselves. Your working directory is the first.
$(worktree_lines)

Get oriented, then stop and wait for me:
1. $orient
2. Read $(ticket_source "$ticket"). Read-only: do not comment on, edit or transition it.
3. Restate the acceptance criteria in your own words and flag anything ambiguous, underspecified or with a hidden dependency.
4. Name every repo the ticket touches, and say if it needs one that has no worktree above.
5. Look through the code in these worktrees until you know where the work lives, and tell me briefly.
6. Once you know what the ticket is about, $(title_instruction)
Do not write an implementation plan and do not change anything. I will say what to do next.
EOF
}

# The first prompt when I give my own: the facts of the session, then my words in place of the default steps.
custom_prompt() {
  local ticket=$1 source=$2 extra=$3 notes
  if [[ -n "$source" ]]; then
    echo "This session is a fork of $source, moving on to $ticket."
  else
    echo "This session is for $ticket."
  fi
  echo
  if [[ "$JIRA" == yes ]]; then
    echo "$ticket is a Jira ticket: read $(ticket_source "$ticket"). Read-only: do not comment on, edit or transition it."
  else
    echo "$ticket is not a Jira ticket: there is nothing to look up."
  fi
  echo
  local paths="never in the repo folders themselves"
  [[ -z "$source" ]] || paths+=", even where earlier messages name other paths"
  echo "These git worktrees were made for it, one per repo. Read and change files only in them, $paths. Your working directory is the first."
  worktree_lines
  if [[ -z "$source" ]]; then
    notes=$(notes_files)
    [[ -n "$notes" ]] && printf '\nNotes on these repos and how they connect to each other (they may be out of date):\n%s\n' "$notes"
  fi
  printf '\nOnce you know what the work is about, %s\n' "$(title_instruction)"
  printf '\n%s\n' "$extra"
}

fork_prompt() {
  local ticket=$1 source=$2
  if [[ "$JIRA" == no ]]; then
    cat <<EOF
This session is a fork of $source, moving on to $ticket. This is not a Jira ticket: there is nothing to look up, and I will describe the work.

These git worktrees were made for it, one per repo. Read and change files only in them, even where earlier messages name other paths. Your working directory is now the first.
$(worktree_lines)

Do not change anything until I say what the work is. When I have described it, $(title_instruction)
EOF
    return
  fi
  cat <<EOF
This session is a fork of $source, moving on to Jira ticket $ticket.

These git worktrees were made for this ticket, one per repo. Read and change files only in them, even where earlier messages name other paths. Your working directory is now the first.
$(worktree_lines)

Get oriented on the new ticket, using what we already know about these repos rather than reading them again, then stop and wait for me:
1. Read $(ticket_source "$ticket"). Read-only: do not comment on, edit or transition it.
2. Restate the acceptance criteria in your own words and flag anything ambiguous, underspecified or with a hidden dependency.
3. Name every repo the ticket touches, and say if it needs one that has no worktree above.
4. Say briefly where the work lives in the code, looking further only where this ticket goes beyond what we have covered.
5. Once you know what the new ticket is about, $(title_instruction)
Do not write an implementation plan and do not change anything. I will say what to do next.
EOF
}

# --add-dir for each folder the session needs besides its working directory (WORKTREES[0]):
# the other worktrees of this command, every worktree recorded for the session when one is
# given (so repos added with seance add keep their access on resume), and the notes folder.
extra_dirs() {
  local sid=${1:-} dir
  local -a dirs=("${WORKTREES[@]:1}")
  local -A seen=(["${WORKTREES[0]}"]=1)
  [[ -z "$sid" ]] || mapfile -t -O "${#dirs[@]}" dirs < <(session_worktrees "$sid")
  [[ -z "$NOTES_DIR" ]] || dirs+=("$NOTES_DIR")
  for dir in "${dirs[@]}"; do
    [[ -d "$dir" && -z "${seen[$dir]:-}" ]] || continue
    seen[$dir]=1
    printf '%s\0%s\0' --add-dir "$dir"
  done
}

record_all() {
  local ticket=$1 name=$2 sid=$3 source=$4 i
  for i in "${!WORKTREES[@]}"; do
    record_session "${REPO_NAMES[$i]}" "$ticket" "$name" "$sid" "${WORKTREES[$i]}" "$source"
  done
}

# The few words a session named itself with (the latest wins), or nothing.
session_title() {
  awk -F'\t' -v sid="$1" '$1 == sid { t = $2 } END { print t }' "$TITLES_FILE" 2>/dev/null || true
}

# <repo>-<ticket>-<words> for a titled seance session, from its first record; nothing otherwise.
titled_name() {
  local title repo="" ticket=""
  title=$(session_title "$1")
  [[ -n "$title" ]] || return 0
  IFS=$'\t' read -r repo ticket < <(awk -F'\t' -v sid="$1" 'NR > 1 && $5 == sid { print $2 "\t" $3; exit }' "$SESSIONS_FILE" 2>/dev/null) || true
  [[ -z "$repo" ]] || echo "$repo-$ticket-$title"
}

# -n and the titled name, one per line, for claude --resume; nothing if the session has no title.
name_args() {
  local name
  name=$(titled_name "$1")
  [[ -z "$name" ]] || printf '%s\n%s\n' -n "$name"
}

# A few words as lowercase-and-hyphens: at most five words and 40 characters.
slugify() {
  tr '[:upper:]' '[:lower:]' <<<"$1" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -d- -f1-5 | cut -c1-40 | sed -E 's/-+$//'
}

# Name a seance session: inside one, seance title "<words>"; from anywhere, seance title <session-id> "<words>".
cmd_title() {
  local sid words slug full
  if [[ $# -eq 2 ]]; then
    sid=$1 words=$2
  else
    sid=${CLAUDE_CODE_SESSION_ID:-} words=${1:-}
    [[ -n "$sid" ]] || die 'outside a Claude session, give the session too: seance title <session-id> "<words>"'
  fi
  [[ "$sid" != here ]] && is_session_ref "$sid" || die "'$sid' is not a session id"
  full=$(awk -F'\t' -v id="$sid" 'NR > 1 && index($5, id) == 1 { print $5 }' "$SESSIONS_FILE" 2>/dev/null | sort -u)
  [[ -n "$full" ]] || die "no seance session $sid (see: seance list)"
  [[ $(wc -l <<<"$full") -eq 1 ]] || die "$sid matches more than one session; give the full id"
  slug=$(slugify "$words")
  [[ -n "$slug" ]] || die 'give a few words, for example: seance title "rotate demo lb certs"'
  record_title "$full" "$slug"
  echo "Named ${full:0:8}: $(titled_name "$full")"
  note "the Claude session itself takes this name the next time seance resumes it"
}

record_title() {
  mkdir -p "$SEANCE_HOME"
  printf '%s\t%s\t%s\n' "$1" "$2" "$(date -Iseconds)" >>"$TITLES_FILE"
}

last_session_for() {
  awk -F'\t' -v wt="$1" 'NR > 1 && $6 == wt { sid = $5 } END { print sid }' "$SESSIONS_FILE" 2>/dev/null || true
}

resume_session() {
  local sid=$1 background=$2 extra=$3 live kind
  live=$(claude agents --json 2>/dev/null | jq -c --arg sid "$sid" '.[] | select(.sessionId == $sid)' | head -1)
  if [[ -n "$live" ]]; then
    kind=$(jq -r .kind <<<"$live")
    if [[ "$kind" == background ]]; then
      echo "Already running in the background: claude attach $(jq -r .id <<<"$live")"
    else
      echo "Already open in another terminal (pid $(jq -r .pid <<<"$live"))."
    fi
    [[ -z "$extra" ]] || note "your prompt was not sent; type it in the session"
    return
  fi
  local -a dirs=() words=() named=()
  mapfile -d '' dirs < <(extra_dirs "$sid")
  [[ -z "$extra" ]] || words=("$extra")
  mapfile -t named < <(name_args "$sid")
  cd "${WORKTREES[0]}"
  if [[ "$background" == yes ]]; then
    claude --bg --resume "$sid" "${named[@]}" "${dirs[@]}" "${words[@]}" 2>&1 | grep -v 'blocked by enterprise policy'
    return
  fi
  note "resuming ${sid:0:8} (seance --new starts a fresh session instead)"
  exec claude --resume "$sid" "${named[@]}" "${dirs[@]}" "${words[@]}"
}

start_session() {
  local ticket=$1 source=$2 background=$3 extra=$4
  local name="${REPO_NAMES[0]}-$ticket" prompt sid out short
  [[ -z "$TITLE_SLUG" ]] || name+="-$TITLE_SLUG"
  START_NAME=$name
  local -a args=(-n "$name") dirs=()
  mapfile -d '' dirs < <(extra_dirs)
  args+=("${dirs[@]}")

  if [[ -n "$extra" ]]; then
    prompt=$(custom_prompt "$ticket" "$source" "$extra")
  elif [[ -n "$source" ]]; then
    prompt=$(fork_prompt "$ticket" "$source")
  else
    prompt=$(new_prompt "$ticket")
  fi
  [[ -z "$source" ]] || args+=(--resume "$source" --fork-session)

  cd "${WORKTREES[0]}"

  if [[ "$background" == yes ]]; then
    out=$(claude --bg "${args[@]}" "$prompt" 2>&1 | grep -v 'blocked by enterprise policy') || {
      echo "$out" >&2
      die "claude --bg failed"
    }
    short=$(sed -n 's/^backgrounded · \([0-9a-f]*\) · .*/\1/p' <<<"$out" | head -1)
    [[ -n "$short" ]] || { echo "$out" >&2; die "could not read the background session's id"; }
    sid=""
    for _ in 1 2 3 4 5; do
      sid=$(claude agents --json 2>/dev/null | jq -r --arg id "$short" '.[] | select(.id == $id) | .sessionId' | head -1)
      [[ -n "$sid" ]] && break
      sleep 1
    done
    record_all "$ticket" "${REPO_NAMES[0]}-$ticket" "${sid:-$short}" "${source:--}"
    [[ -z "$TITLE_SLUG" ]] || record_title "${sid:-$short}" "$TITLE_SLUG"
    echo "Started $name in the background ($short), in ${WORKTREES[0]}"
    echo "  claude attach $short"
    return
  fi

  sid=$(cat /proc/sys/kernel/random/uuid)
  record_all "$ticket" "${REPO_NAMES[0]}-$ticket" "$sid" "${source:--}"
  [[ -z "$TITLE_SLUG" ]] || record_title "$sid" "$TITLE_SLUG"
  exec claude "${args[@]}" --session-id "$sid" "$prompt"
}

# Add repos' worktrees to the session this runs in, for the ticket that session works on.
cmd_add() {
  local repos=$1 ticket=${2:-} do_fetch=$3 no_jira=$4
  if [[ -z "$ticket" ]]; then
    [[ "$PWD/" =~ /$WORKTREE_DIR/([^/]+)/ ]] || die "cannot tell the ticket from $PWD; give it: seance add <repo>[,<repo2>] <TICKET>"
    ticket=${BASH_REMATCH[1]}
  else
    ticket=$(work_name "$ticket" "$no_jira" "${repos%%,*}")
  fi

  resolve_repos "$repos" "$ticket" "$do_fetch"

  local sid=${CLAUDE_CODE_SESSION_ID:-} name="${REPO_NAMES[0]}-$ticket"
  if [[ -n "$sid" ]]; then
    local known
    known=$(awk -F'\t' -v sid="$sid" 'NR > 1 && $5 == sid { name = $4 } END { print name }' "$SESSIONS_FILE" 2>/dev/null || true)
    [[ -n "$known" ]] && name=$known
    record_all "$ticket" "$name" "$sid" "-"
  fi

  local i
  for i in "${!WORKTREES[@]}"; do
    echo "Worktree ready: ${WORKTREES[$i]} (branch ${BRANCHES[$i]})"
  done
  echo "Give the session access by typing this at its prompt:"
  for i in "${!WORKTREES[@]}"; do
    echo "  /add-dir ${WORKTREES[$i]}"
  done
}

# Resolve a comma-separated list of repos (no spaces) into REPO_NAMES, WORKTREES, BRANCHES.
resolve_repos() {
  local list=$1 ticket=$2 do_fetch=$3 name
  local -a names
  [[ "$list" =~ ^[^,[:space:]]+(,[^,[:space:]]+)*$ ]] || die "'$list' is not a repo or a comma-separated list of repos (no spaces)"
  IFS=, read -ra names <<<"$list"
  for name in "${names[@]}"; do
    [[ -n "$(repo_field "$name" 2)" ]] || die "no repo '$name' in $REPOS_FILE (see: seance repos)"
  done
  for name in "${names[@]}"; do
    resolve_repo "$name" "$ticket" "$do_fetch"
  done
}

# Look a repo up, check it, and prepare its worktree; appends to REPO_NAMES, WORKTREES, BRANCHES.
resolve_repo() {
  local repo_name=$1 ticket=$2 do_fetch=$3 path pinned branch
  path=$(repo_field "$repo_name" 2)
  pinned=${BASE_OVERRIDE:-$(repo_field "$repo_name" 3)}
  [[ -n "$path" ]] || die "no repo '$repo_name' in $REPOS_FILE (see: seance repos)"
  git -C "$path" rev-parse --git-dir >/dev/null 2>&1 || die "$path is not a git repository"
  branch=$(branch_name "$repo_name" "$ticket")
  WORKTREE=""
  prepare_worktree "$path" "$ticket" "$do_fetch" "$pinned" "$branch"
  REPO_NAMES+=("$repo_name")
  WORKTREES+=("$WORKTREE")
  BRANCHES+=("$branch")
}

cmd_repos() {
  [[ -f "$REPOS_FILE" ]] || die "no lookup table at $REPOS_FILE"
  repo_table | column -t -s $'\t'
}

cmd_list() {
  [[ -f "$REPOS_FILE" ]] || die "no lookup table at $REPOS_FILE"
  local agents registry titles
  agents=$(claude agents --json --all 2>/dev/null || echo '[]')
  registry=$(tail -n +2 "$SESSIONS_FILE" 2>/dev/null || true)
  titles=$(cat "$TITLES_FILE" 2>/dev/null || true)

  local bold="" dim="" reset=""
  if [[ -t 1 ]]; then
    bold=$'\e[1m' dim=$'\e[2m' reset=$'\e[0m'
  fi
  local width=${COLUMNS:-}
  [[ -n "$width" ]] || width=$(tput cols 2>/dev/null || echo 80)
  ((width > 100)) && width=100

  local name path first=yes
  while IFS=$'\t' read -r name path; do
    [[ "$first" == yes ]] && first=no || echo

    local shown=${path/#$HOME/\~} fill rule
    fill=$((width - ${#name} - ${#shown} - 6))
    ((fill < 3)) && fill=3
    rule=$(printf '─%.0s' $(seq "$fill"))
    printf '── %s%s%s %s %s%s%s\n' "$bold" "$name" "$reset" "$rule" "$dim" "$shown" "$reset"

    if [[ ! -d "$path/.git" && ! -f "$path/.git" ]]; then
      printf '   %s(missing)%s\n' "$dim" "$reset"
      continue
    fi

    local wt branch
    while IFS=$'\t' read -r wt branch; do
      local label=${wt#"$path"/}
      [[ "$label" == "$WORKTREE_DIR"/* ]] && label=${label#"$WORKTREE_DIR"/}
      [[ "$wt" == "$path" ]] && label="repo folder"
      local link=""
      if [[ -n "$JIRA_URL" && "$wt" != "$path" && "$label" =~ ^[A-Z][A-Z0-9]+-[0-9]+$ ]]; then
        link="  $dim$(ticket_url "$label")$reset"
      fi
      printf '   %-22s  %s%s\n' "$label" "$branch" "$link"

      jq -r --arg wt "$wt" --arg reg "$registry" --arg titles "$titles" --arg dim "$dim" --arg reset "$reset" '
        ($reg | split("\n") | map(select(length > 0) | split("\t"))) as $rows
        | ($titles | split("\n") | map(select(length > 0) | split("\t") | {key: .[0], value: .[1]}) | from_entries) as $tmap
        | ($rows | map(select(.[5] == $wt) | . as $r
            | ($rows | map(select(.[4] == $r[4])) | first) as $first
            | {repo: .[1], ticket: .[2], sid: .[4], forked: .[6],
               name: (if $tmap[$r[4]] then "\($first[1])-\($first[2])-\($tmap[$r[4]])" else .[3] end)})
          | unique_by(.sid)) as $ours
        | (map({key: .sessionId, value: .}) | from_entries) as $live
        | ($ours | map(.sid)) as $ourIds
        | ($ours[] | . as $s | ($live[$s.sid] // null) as $a
            | ($rows | map(select(.[4] == $s.sid) | .[1])
               | reduce .[] as $r ([]; if index([$r]) then . else . + [$r] end) | join(",")) as $repos
            | "     └─ \($s.name)  \($dim)\($s.sid[0:8])\($reset)  "
              + (if $a == null then "stopped \($dim)(seance \($repos) \($s.ticket))\($reset)"
                 else "\($a.kind) \($a.status // $a.state)" end)
              + (if $s.forked != "-" then "  \($dim)fork of \($s.forked[0:8])\($reset)" else "" end)),
          (.[] | select(.cwd == $wt and ((.sessionId | IN($ourIds[])) | not))
            | "     └─ \(.name)  \($dim)\(.sessionId[0:8])\($reset)  \(.kind) \(.status // .state)  \($dim)(not from seance)\($reset)")
      ' <<<"$agents"
    done < <(worktree_rows "$path")
  done < <(repo_names)
}

# A repo's worktrees, its own folder first: path, branch (or "(detached)").
worktree_rows() {
  git -C "$1" worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10); branch = "" }
    /^branch /   { branch = substr($0, 19) }
    /^detached/  { branch = "(detached)" }
    /^$/         { if (path != "") print path "\t" branch; path = "" }
    END          { if (path != "") print path "\t" branch }'
}

# Everything seance knows, as JSON for other tools: repos with their worktrees, and sessions.
# A session's state is running, idle, open (in a terminal somewhere) or stopped, and its
# action is what to do with it: attach (attach_id), open (already open: pid) or resume.
cmd_list_json() {
  [[ -f "$REPOS_FILE" ]] || die "no lookup table at $REPOS_FILE"
  local agents registry worktrees name path
  agents=$(claude agents --json --all 2>/dev/null || echo '[]')
  registry=$(tail -n +2 "$SESSIONS_FILE" 2>/dev/null || true)
  worktrees=$(while IFS=$'\t' read -r name path; do
    [[ -d "$path/.git" || -f "$path/.git" ]] || continue
    worktree_rows "$path" | sed "s|^|$name\t|"
  done < <(repo_names))

  jq -n --argjson agents "$agents" --arg reg "$registry" --arg wts "$worktrees" \
    --arg titles "$(cat "$TITLES_FILE" 2>/dev/null || true)" \
    --arg repos "$(awk '$0 !~ /^[[:space:]]*(#|$)/ { print $1 "\t" $2 "\t" $3 }' "$REPOS_FILE")" \
    --arg wtdir "$WORKTREE_DIR" --arg jira "$JIRA_URL" '
    def lines($s): $s | split("\n") | map(select(length > 0) | split("\t"));
    def uniq: reduce .[] as $x ([]; if index([$x]) then . else . + [$x] end);
    def nonempty: if . == "" then null else . end;
    def ticket_of: if . != null and contains("/" + $wtdir + "/") then split("/" + $wtdir + "/") | last | split("/")[0] else null end;
    def is_key: . != null and test("^[A-Z][A-Z0-9]+-[0-9]+$");

    lines($reg) as $rows
    | (lines($titles) | map({key: .[0], value: .[1]}) | from_entries) as $tmap
    | (lines($repos) | map({name: .[0], path: (.[1] | rtrimstr("/")), base: (.[2] // "" | nonempty)})) as $repotab
    | (lines($wts) | map({repo: .[0], path: .[1], branch: (.[2] | nonempty)})) as $wtl
    | ($wtl | map(.path)) as $wtpaths
    | ($agents | map({key: .sessionId, value: .}) | from_entries) as $live
    | ($rows | map(.[4]) | reverse | uniq) as $sids

    | def session($a; $sid; $name; $repos; $ticket; $wts; $cwd; $ours; $forked; $created; $resumable):
        (if $a == null or ($a.kind == "background" and $a.status == null and ($a.state == "done" or $a.state == null)) then "stopped"
         elif $a.kind == "background" then (if $a.status == "busy" or $a.status == null then "running" else $a.status end)
         else "open" end) as $state
        | {session_id: $sid, short_id: $sid[0:8], name: $name, ticket: $ticket,
           jira_url: (if $jira != "" and ($ticket | is_key) then "\($jira)/browse/\($ticket)" else null end),
           repos: $repos, worktrees: $wts, cwd: $cwd, state: $state,
           kind: (if $state == "stopped" then null else $a.kind end),
           status: (if $state == "stopped" then null else ($a.status // $a.state) end),
           from_seance: $ours, forked_from: (if $forked == "-" then null else $forked end), created: $created,
           action: (if $state == "stopped" then "resume" elif $a.kind == "background" then "attach" else "open" end),
           attach_id: (if $state == "stopped" or $a.kind != "background" then null else $a.id end),
           pid: (if $state == "open" then $a.pid else null end),
           resumable: $resumable};
      def wt_of($c): [$wtl[] | . as $w | select($c == $w.path or ($c | startswith($w.path + "/")))] | max_by(.path | length);

      [ $sids[] as $sid
        | ($rows | map(select(.[4] == $sid))) as $mine
        | ($mine | map(.[5]) | uniq) as $wt
        | ($tmap[$sid] // null) as $title
        | session($live[$sid] // null; $sid;
                  (if $title then "\($mine[0][1])-\($mine[0][2])-\($title)" else $mine[0][3] end);
                  ($mine | map(.[1]) | uniq); $mine[0][2];
                  $wt; $wt[0]; true; $mine[0][6]; $mine[0][0]; ($wt[0] | IN($wtpaths[])))
        | . + {title: $title} ]
      + [ $agents[] | select(.sessionId | IN($sids[]) | not) | wt_of(.cwd) as $w | select($w != null)
          | session(.; .sessionId; .name; [$w.repo]; ($w.path | ticket_of); [$w.path]; .cwd; false; "-";
                    (if .startedAt then (.startedAt / 1000 | floor | todate) else null end); true)
          | . + {title: null} ]
    | . as $sessions

    | {version: 1, generated: (now | floor | todate),
       repos: [$repotab[] | . as $r
         | ($wtl | map(select(.repo == $r.name))) as $mine
         | {name, path, base, present: ($mine | length > 0),
            worktrees: [$mine[] | . as $w | (.path | ticket_of) as $t
              | {path, branch, repo_folder: (.path == $r.path), ticket: $t,
                 jira_url: (if $jira != "" and ($t | is_key) then "\($jira)/browse/\($t)" else null end),
                 session_ids: [$sessions[] | select(.worktrees | index([$w.path])) | .session_id]}]}],
       sessions: $sessions}'
}

# One line per session, newest first: action, target, dir, repo, name, short id, state.
# action is attach (target: agent id), open (target: pid) or resume (target: session id).
# dir is - except for a session seance did not start: the folder to resume it in.
PICK_ROW='[.action,
    (if .action == "attach" then .attach_id elif .action == "open" then (.pid | tostring) else .session_id end),
    (if .from_seance or .action != "resume" then "-" else .cwd end),
    (.repos | join(",")), .name, .short_id,
    ((if .state == "stopped" then "stopped" elif .kind == "background" then "background \(.status)" else "\(.kind) \(.status)" end)
     + (if .from_seance then "" else "  (not from seance)" end))]
  | join("\t")'

pick_rows() {
  cmd_list_json | jq -r ".sessions[] | select(.action != \"resume\" or .resumable) | $PICK_ROW"
}

# The worktrees a session was recorded in, the one it started in first.
session_worktrees() {
  awk -F'\t' -v sid="$1" 'NR > 1 && $5 == sid && !seen[$6]++ { print $6 }' "$SESSIONS_FILE" 2>/dev/null || true
}

cmd_pick() {
  [[ -f "$REPOS_FILE" ]] || die "no lookup table at $REPOS_FILE"
  is_terminal || die "pick needs a terminal"

  local -a actions=() targets=() dirs_in=() cells=() lines=() wts=()
  local action target dir repo name short state
  while IFS=$'\t' read -r action target dir repo name short state; do
    if [[ "$action" == resume && "$dir" == - ]]; then
      mapfile -t wts < <(session_worktrees "$target")
      [[ ${#wts[@]} -gt 0 && -d "${wts[0]}" ]] || continue
    elif [[ "$action" == resume ]]; then
      [[ -d "$dir" ]] || continue
    fi
    actions+=("$action") targets+=("$target") dirs_in+=("$dir")
    cells+=("$repo"$'\t'"$name"$'\t'"$short"$'\t'"$state")
  done < <(pick_rows)
  ((${#cells[@]} > 0)) || die "no sessions to pick from"
  mapfile -t lines < <(printf '%s\n' "${cells[@]}" | column -t -s $'\t' -o '  ')

  local i="" choice
  if command -v fzf >/dev/null; then
    choice=$(for i in "${!lines[@]}"; do printf '%s\t%s\n' "$i" "${lines[$i]}"; done |
      fzf --delimiter=$'\t' --with-nth=2 --tiebreak=index --reverse --height=40% --prompt='session> ') || exit 0
    i=${choice%%$'\t'*}
  else
    local line
    PS3="session> "
    select line in "${lines[@]}"; do
      [[ -n "$line" ]] && { i=$((REPLY - 1)); break; }
    done
    [[ -n "$i" ]] || exit 0
  fi

  act_on "${actions[$i]}" "${targets[$i]}" "${dirs_in[$i]}"
}

# Do a pick row's action: attach to it, say it is open elsewhere, or resume it.
act_on() {
  local action=$1 target=$2 dir=$3 wts=()
  case $action in
    attach) exec claude attach "$target" ;;
    open) die "already open in another terminal (pid $target)" ;;
    resume)
      local -a dirs=()
      if [[ "$dir" != - ]]; then
        WORKTREES=("$dir")
        mapfile -d '' dirs < <(extra_dirs)
        cd "$dir"
        note "resuming ${target:0:8} in $dir"
        exec claude --resume "$target" "${dirs[@]}"
      fi
      mapfile -t wts < <(session_worktrees "$target")
      [[ ${#wts[@]} -gt 0 && -d "${wts[0]}" ]] || die "session ${target:0:8} has no worktree left to resume in"
      WORKTREES=("${wts[0]}")
      mapfile -d '' dirs < <(extra_dirs "$target")
      cd "${wts[0]}"
      note "resuming ${target:0:8} in ${wts[0]}"
      local -a named=()
      mapfile -t named < <(name_args "$target")
      exec claude --resume "$target" "${named[@]}" "${dirs[@]}"
      ;;
  esac
}

# Open one session by id (full or the 8-character short id): what pick does with a chosen row.
cmd_open() {
  local id=$1 row action target dir
  [[ "$id" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$ ]] || die "'$id' is not a session id"
  row=$(cmd_list_json | jq -r --arg id "$id" "[.sessions[] | select(.session_id == \$id or .short_id == \$id)] | first // empty | $PICK_ROW")
  [[ -n "$row" ]] || die "no session $id (see: seance list)"
  IFS=$'\t' read -r action target dir _ <<<"$row"
  act_on "$action" "$target" "$dir"
}

main() {
  local background=auto do_fetch=auto force_new=no no_jira=no json=no
  while [[ $# -gt 0 && "$1" == -* ]]; do
    case "$1" in
      --json) json=yes ;;
      --bg) background=yes ;;
      --no-fetch) do_fetch=no ;;
      --base)
        [[ $# -ge 2 ]] || die "--base needs a branch, for example: --base develop"
        BASE_OVERRIDE=$2
        shift
        ;;
      --base=*) BASE_OVERRIDE=${1#--base=} ;;
      --title)
        [[ $# -ge 2 ]] || die 'title needs a few words, for example: --title "rotate demo lb certs"'
        TITLE_SLUG=$(slugify "$2")
        [[ -n "$TITLE_SLUG" ]] || die 'title needs a few words, for example: --title "rotate demo lb certs"'
        shift
        ;;
      --title=*)
        TITLE_SLUG=$(slugify "${1#--title=}")
        [[ -n "$TITLE_SLUG" ]] || die 'title needs a few words, for example: --title="rotate demo lb certs"'
        ;;
      -n | --no-jira) no_jira=yes ;;
      --new) force_new=yes ;;
      -h | --help) usage 0 ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  if [[ -n "$BASE_OVERRIDE" ]]; then
    BASE_OVERRIDE=${BASE_OVERRIDE#origin/}
    git check-ref-format --branch "$BASE_OVERRIDE" >/dev/null 2>&1 || die "'$BASE_OVERRIDE' is not a branch name (--base)"
  fi

  case "${1:-}" in
    "" | help | -h) usage 0 ;;
    list)
      if [[ "$json" == yes || "${2:-}" == --json ]]; then cmd_list_json; else cmd_list; fi
      return
      ;;
    pick) cmd_pick; return ;;
    title)
      [[ $# -ge 2 && $# -le 3 ]] || usage 1
      shift
      cmd_title "$@"
      return
      ;;
    open)
      [[ $# -eq 2 ]] || usage 1
      cmd_open "$2"
      return
      ;;
    repos) cmd_repos; return ;;
  esac

  # Run from a terminal by a person: open the session here.
  # Run by Claude (no terminal): start it in the background.
  [[ "$do_fetch" == auto ]] && do_fetch=yes
  if is_terminal; then
    [[ "$background" == auto ]] && background=no
  else
    background=yes
  fi

  REPO_NAMES=() WORKTREES=() BRANCHES=()

  if [[ "$1" == add ]]; then
    [[ -z "$TITLE_SLUG" ]] || die "--title names a session; seance add does not start one (use seance title)"
    [[ $# -ge 2 && $# -le 3 ]] || usage 1
    cmd_add "$2" "${3:-}" "$do_fetch" "$no_jira"
    return
  fi

  [[ $# -ge 2 && $# -le 4 ]] || usage 1
  local repos=$1 ticket source="" extra=""
  ticket=$(work_name "$2" "$no_jira" "${repos%%,*}")
  shift 2
  if [[ $# -gt 0 ]] && is_session_ref "$1"; then
    source=$1
    shift
  fi
  if [[ $# -gt 0 ]]; then
    extra=$1
    shift
  fi
  [[ $# -eq 0 ]] || die "'$1': the prompt goes last, after any session id (quote it if it has spaces)"
  [[ "$extra" != -* ]] || die "options go before the arguments ('$extra')"
  JIRA=yes
  if [[ "$no_jira" == yes ]] || ! is_jira_key "$ticket"; then
    JIRA=no
  fi

  local fork_self=no
  if [[ "$source" == here ]]; then
    source=${CLAUDE_CODE_SESSION_ID:-}
    [[ -n "$source" ]] || die "'here' only works inside a Claude session"
    fork_self=yes
  fi

  resolve_repos "$repos" "$ticket" "$do_fetch"

  # Forking the session that is running this command: a fork made now would copy a
  # conversation that ends on this very command, still without its result, and open on
  # "No result recorded ... Interrupted" without its first prompt. So the worktrees are made
  # now (errors show here), and the fork itself is left to a detached seance run a few seconds
  # on, once this command has finished and its result is recorded.
  if [[ "$fork_self" == yes ]]; then
    local -a again=("$0" --bg)
    [[ -z "$TITLE_SLUG" ]] || again+=(--title "$TITLE_SLUG")
    [[ -z "$BASE_OVERRIDE" ]] || again+=(--base "$BASE_OVERRIDE")
    [[ "$no_jira" == no ]] || again+=(--no-jira)
    again+=("$repos" "$ticket" "$source")
    [[ -z "$extra" ]] || again+=("$extra")
    mkdir -p "$SEANCE_HOME"
    setsid -f bash -c 'sleep "$1"; shift; exec "$@"' seance-fork "$FORK_DELAY" "${again[@]}" \
      </dev/null >>"$SEANCE_HOME/forks.log" 2>&1
    local name="${REPO_NAMES[0]}-$ticket"
    [[ -z "$TITLE_SLUG" ]] || name+="-$TITLE_SLUG"
    echo "Forking this session onto $ticket as $name, starting in ${FORK_DELAY}s once this command has finished."
    echo "It then shows in seance list and the desktop app (seance pick opens it); its output goes to $SEANCE_HOME/forks.log."
    return
  fi

  local previous
  previous=$(last_session_for "${WORKTREES[0]}")
  if [[ -z "$source" && "$force_new" == no && -n "$previous" ]]; then
    if [[ -n "$TITLE_SLUG" ]]; then
      record_title "$previous" "$TITLE_SLUG"
      note "named ${previous:0:8}: $(titled_name "$previous")"
    fi
    resume_session "$previous" "$background" "$extra"
    return
  fi
  start_session "$ticket" "$source" "$background" "$extra"
}

main "$@"
